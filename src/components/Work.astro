---
import { projects } from "../data/site";
---
<section id="work"><div class="wrap">
  <div class="head"><h2>Work</h2><p class="note">Things I've built, and the problems behind them.</p></div>
  <div class="grid3">
    {projects.map((p) => (
      <a class="case" href={p.href}>
        <img class="ph" style="object-fit: contain;" src={`/projects/${p.image}.webp`} alt={p.title}/>
        <h3>{p.title}</h3>
        <p>{p.summary}</p>
        <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
      </a>
    ))}
  </div>
  <div class="ph" style="margin-top:1rem;height:110px">Open-source strip: GitHub contribution graph + “Now building” list</div>
</div></section>
