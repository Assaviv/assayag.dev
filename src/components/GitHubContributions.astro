---
type Contribution = { date: string; count: number; level: number };

let contributions: Contribution[] = [];
let initialTotal = 0;
let loadedWithToken = false;
const githubToken = import.meta.env.GITHUB_TOKEN;

if (githubToken) {
  try {
    const to = new Date();
    const from = new Date(to);
    from.setUTCDate(from.getUTCDate() - 29);
    const query = `query($from: DateTime!, $to: DateTime!) { user(login: "Assaviv") { contributionsCollection(from: $from, to: $to) { contributionCalendar { totalContributions weeks { contributionDays { date contributionCount contributionLevel } } } } } }`;
    const response = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: { Authorization: `Bearer ${githubToken}`, "Content-Type": "application/json" },
      body: JSON.stringify({
        query,
        variables: { from: from.toISOString(), to: to.toISOString() },
      }),
    });
    if (!response.ok) throw new Error("GitHub GraphQL request failed");
    const result = await response.json() as {
      data?: { user?: { contributionsCollection?: { contributionCalendar?: { totalContributions: number; weeks: { contributionDays: { date: string; contributionCount: number; contributionLevel: string }[] }[] } } } };
    errors?: unknown[];
  };
    const calendar = result.data?.user?.contributionsCollection?.contributionCalendar;
    if (result.errors?.length || !calendar) throw new Error("GitHub contribution data unavailable");
    const levels: Record<string, number> = { NONE: 0, FIRST_QUARTILE: 1, SECOND_QUARTILE: 2, THIRD_QUARTILE: 3, FOURTH_QUARTILE: 4 };
    const fromDate = from.toISOString().slice(0, 10);
    const toDate = to.toISOString().slice(0, 10);
    contributions = calendar.weeks.flatMap((week) => week.contributionDays
      .filter((day) => day.date >= fromDate && day.date <= toDate)
      .map((day) => ({
      date: day.date,
      count: day.contributionCount,
      level: levels[day.contributionLevel] ?? 0,
    })));
    initialTotal = calendar.totalContributions;
    loadedWithToken = true;
  } catch {
    // A missing, expired, or insufficiently scoped token falls back to public contribution data in the browser.
  }
}
---
<section class="contributions" aria-labelledby="contributions-title">
  <div class="contributions-head">
    <div>
      <h3 id="contributions-title">Open-source activity</h3>
      <p class="note" id="contributions-summary" aria-live="polite">{loadedWithToken ? `${initialTotal.toLocaleString()} contributions in the last 30 days` : "Loading GitHub contributions…"}</p>
    </div>
    <a class="github-link" href="https://github.com/Assaviv" target="_blank" rel="noreferrer">@Assaviv <span aria-hidden="true">↗</span></a>
  </div>
  <div class="calendar-scroll" tabindex="0" aria-label="Scrollable GitHub contribution calendar">
    <div class="calendar" id="github-calendar" role="img" aria-label="GitHub contribution calendar for Assaviv">
      {loadedWithToken && contributions.map((contribution) => (
        <span class="calendar-day" data-level={contribution.level} aria-label={`${contribution.count} contributions on ${new Date(`${contribution.date}T00:00:00`).toLocaleDateString(undefined, { dateStyle: "long" })}`} title={`${contribution.count} contributions on ${new Date(`${contribution.date}T00:00:00`).toLocaleDateString()}`}></span>
      ))}
    </div>
  </div>
  <div class="calendar-footer"><span>Less</span><div class="legend" aria-hidden="true"><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i></div><span>More</span></div>
  <p class="contributions-error" id="contributions-error" hidden>Contribution data is temporarily unavailable. <a href="https://github.com/Assaviv" target="_blank" rel="noreferrer">View GitHub profile</a>.</p>
</section>

{!loadedWithToken && <script>
  const calendar = document.querySelector<HTMLElement>("#github-calendar");
  const summary = document.querySelector<HTMLElement>("#contributions-summary");
  const error = document.querySelector<HTMLElement>("#contributions-error");

  async function loadContributions() {
    if (!calendar || !summary || !error) return;
    try {
      const response = await fetch("https://github-contributions-api.jogruber.de/v4/Assaviv?y=last", { headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error("Contribution service unavailable");
      const data: { total: Record<string, number>; contributions: { date: string; count: number; level: number }[] } = await response.json();
      const days = data.contributions;
      if (!days?.length) throw new Error("No contribution data");

      const latest = new Date(`${days[days.length - 1].date}T00:00:00`);
      const cutoff = new Date(latest);
      cutoff.setDate(cutoff.getDate() - 29);
      const visibleDays = days.filter(({ date }) => {
        const day = new Date(`${date}T00:00:00`);
        return day >= cutoff && day <= latest;
      });
      const cells = visibleDays.map((contribution) => {
        const cell = document.createElement("span");
        cell.className = "calendar-day";
        cell.dataset.level = String(contribution.level);
        cell.setAttribute("aria-label", `${contribution.count} contributions on ${new Date(`${contribution.date}T00:00:00`).toLocaleDateString(undefined, { dateStyle: "long" })}`);
        cell.title = `${contribution.count} contributions on ${new Date(`${contribution.date}T00:00:00`).toLocaleDateString()}`;
        return cell;
      });

      calendar.replaceChildren(...cells);
      const total = visibleDays.reduce((sum, day) => sum + day.count, 0);
      summary.textContent = `${total.toLocaleString()} contributions in the last 30 days`;
      calendar.setAttribute("aria-label", `GitHub contribution calendar for Assaviv, ${total} contributions in the last 30 days`);
    } catch {
      calendar.hidden = true;
      summary.hidden = true;
      error.hidden = false;
    }
  }

  loadContributions();
</script>}

<style is:global>
  .contributions{margin-top:1rem;padding:clamp(1rem,2.5vw,1.5rem);border:1px solid var(--line);border-radius:14px;background:var(--surface)}
  .contributions-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem}
  .contributions-head h3{margin:0 0 .2rem;font:700 1.15rem/1.2 var(--display)}
  .github-link{font:400 .8rem var(--mono);color:var(--accent);text-decoration:none;white-space:nowrap}
  .github-link:hover{text-decoration:underline}
  .calendar-scroll{overflow-x:auto;scrollbar-color:var(--line) transparent;overscroll-behavior-inline:contain}
  .calendar{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));grid-template-rows:repeat(3,clamp(22px,4vw,34px));gap:4px;width:100%;padding:.25rem 0}
  .calendar-day,.legend i{display:block;border:1px solid color-mix(in srgb,var(--line) 75%,transparent);border-radius:4px;background:color-mix(in srgb,var(--text) 8%,var(--surface));transition:background-color .2s}
  .legend i{width:11px;height:11px;border-radius:3px}
  .calendar-day[data-level="1"],.legend i[data-level="1"]{background:color-mix(in srgb,var(--accent) 28%,var(--surface))}
  .calendar-day[data-level="2"],.legend i[data-level="2"]{background:color-mix(in srgb,var(--accent) 48%,var(--surface))}
  .calendar-day[data-level="3"],.legend i[data-level="3"]{background:color-mix(in srgb,var(--accent) 70%,var(--surface))}
  .calendar-day[data-level="4"],.legend i[data-level="4"]{background:var(--accent)}
  .calendar-footer{display:flex;justify-content:flex-end;align-items:center;gap:.4rem;margin-top:.55rem;color:var(--mute);font:400 .7rem var(--mono)}
  .legend{display:flex;gap:3px}
  .contributions-error{margin:.8rem 0 0;color:var(--mute);font-size:.85rem}
  .contributions-error a{color:var(--accent)}
  @media(max-width:560px){.contributions{padding:.8rem}.calendar{grid-template-rows:repeat(3,28px);width:100%}.contributions-head h3{font-size:1.05rem}}
</style>
