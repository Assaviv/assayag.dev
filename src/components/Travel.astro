<section id="travel"><div class="wrap">
  <div class="head"><h2>Travel</h2><div id="legend"></div></div>
  <div id="travel-map"></div>
</div></section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { feature } from "topojson-client";
  import world from "world-atlas/countries-110m.json";
  import { places, routes, singles, bothColor, uncoloured } from "../data/travel";

  // set a starting view first: Leaflet needs one before any vector layer (lines, countries) is added
    const map = L.map("travel-map", { worldCopyJump: true, maxZoom: 5 }).setView([30, 55], 3);
  const key = import.meta.env.PUBLIC_CARTO_KEY;
  if (!key) console.warn("PUBLIC_CARTO_KEY is missing: using OpenStreetMap tiles instead. Check your .env and restart the dev server.");
  const tiles = key
    ? `https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=${key}`
    : "https://tile.openstreetmap.org/{z}/{x}/{y}.png";
  L.tileLayer(tiles, {
    attribution:
      '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' +
      (key ? ', © <a href="https://carto.com/attribution/">CARTO</a>' : ""),
    maxNativeZoom: 18,
    maxZoom: 20,
  }).addTo(map);

  map.getPane("tilePane")!.style.filter = !key ? "invert(1) hue-rotate(180deg) brightness(.9)" : "";
  map.setMinZoom(map.getZoom());
  map.setMaxBounds(map.getBounds().pad(0.3));

  // country -> colour (route colour, or bothColor if it's in several routes)
  const colorOf: Record<string, string> = {};
  routes.forEach((r) =>
    r.stops.forEach((c) => (colorOf[c] = c in colorOf && colorOf[c] !== r.color ? bothColor : r.color))
  );

  singles.countries.forEach((c) => (colorOf[c] = singles.color));

  // colour the visited countries
  try {
    const all: any = feature(world as any, (world as any).objects.countries);
    const visited = all.features.filter((f: any) => colorOf[f.properties.name] && !uncoloured.includes(f.properties.name));
    visited.forEach((f: any) => {
      // drop French Guiana & other overseas parts so only mainland France is coloured
      if (f.properties.name === "France" && f.geometry.type === "MultiPolygon")
        f.geometry.coordinates = f.geometry.coordinates.filter((poly: any) => poly[0][0][0] > -20);
    });
    L.geoJSON(visited, {
      interactive: false,
      style: (f: any) => ({ color: colorOf[f.properties.name], weight: 1, fillColor: colorOf[f.properties.name], fillOpacity: 0.35 }),
    }).addTo(map);
  } catch (e) {
    console.error("Country colouring failed:", e);
  }

  // curved "flight" line: quadratic Bézier between two points
  type P = [number, number];
  function arc(a: P, b: P, n = 40): P[] {
    const dy = b[0] - a[0], dx = b[1] - a[1];
    const c: P = [(a[0] + b[0]) / 2 + dx * 0.2, (a[1] + b[1]) / 2 - dy * 0.2];
    return Array.from({ length: n + 1 }, (_, i) => {
      const t = i / n, u = 1 - t;
      return [u * u * a[0] + 2 * u * t * c[0] + t * t * b[0], u * u * a[1] + 2 * u * t * c[1] + t * t * b[1]];
    });
  }
  routes.forEach((r) =>
    r.stops.slice(1).forEach((to, i) =>
      L.polyline(arc(places[r.stops[i]].coords, places[to].coords), { color: r.color, weight: 3, dashArray: "8 8" }).addTo(map)
    )
  );

  // one marker per place (Israel appears once, even though trips start and end there)
  const used = [...new Set([...routes.flatMap((r) => r.stops), ...singles.countries])];
  used.forEach((name) => {
    const pl = places[name];
    L.marker(pl.coords, {
      icon: L.divIcon({ className: "", html: `<span class="pin" style="background:${colorOf[name]}"></span>`, iconSize: [20, 20] }),
    })
      .bindPopup(
        `<figure class="polaroid"><img src="${pl.photo}" alt="${name}"><figcaption><b>${name}</b><br>${pl.text}</figcaption></figure>`,
        { className: "polaroid-popup", minWidth: 200 }
      )
      .addTo(map);
  });

  map.fitBounds(L.latLngBounds(used.map((n) => places[n].coords)), { padding: [40, 40] });

  document.getElementById("legend")!.innerHTML =
    [...routes, singles].map((r) => `<span><i style="background:${r.color}"></i>${r.label}</span>`).join("") +
    (Object.entries(colorOf).some(([n, c]) => c === bothColor && !uncoloured.includes(n))
      ? `<span><i style="background:${bothColor}"></i>Both</span>`
      : "");
</script>

<style is:global>
  #travel-map { height: 520px; border-radius: 12px; z-index: 0; }
  #legend { display: flex; gap: 1rem; font-size: .9rem; }
  #legend span { display: flex; align-items: center; gap: .4rem; }
  #legend i { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .pin {
    display: block; width: 18px; height: 18px; border-radius: 50%;
    border: 3px solid #fff; box-shadow: 0 2px 6px #0007;
  }
  /* Polaroid popup */
  .polaroid-popup .leaflet-popup-content-wrapper { background: transparent; box-shadow: none; padding: 0; }
  .polaroid-popup .leaflet-popup-content { margin: 0; }
  .polaroid-popup .leaflet-popup-tip { display: none; }
  .polaroid {
    margin: 0; background: #fff; padding: 10px 10px 14px; width: 200px; color: #222;
    box-shadow: 0 6px 18px #0006; transform: rotate(-2.5deg);
  }
  .polaroid img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; background: #ddd; }
  .polaroid figcaption { margin-top: 10px; text-align: center; font: 15px/1.3 "Caveat", "Comic Sans MS", cursive; }
</style>
