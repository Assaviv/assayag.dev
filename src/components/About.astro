---
import portrait from "../assets/aviv-portrait.webp";
import { site } from "../data/site";
---
<section id="about"><div class="wrap">
  <div class="head"><h2>About</h2></div>
  <div class="about">
    <img class="avatar" src={portrait.src} width={portrait.width} height={portrait.height} alt={`Close-up portrait of ${site.name}`} loading="lazy" />
    <div>
      <p>{site.aboutText}</p>
      <div class="chips">{site.aboutChips.map((chip) => <span class="ph">[{chip}]</span>)}</div>
      <p class="note" style="margin-top:1.4rem">{site.aboutTimeline}</p>
    </div>
  </div>
</div></section>
